# Gemini API configuration
# Get your key at https://aistudio.google.com/app/apikey
# Free tier is sufficient for testing and ~50 videos/day.
#
# Setup steps:
#   1. Copy this file to ".env" (remove the .example suffix)
#   2. Paste your real key after the equals sign below
#   3. Save the file
#
# IMPORTANT: never commit .env to git. The .gitignore in this folder excludes it.

GEMINI_API_KEY=PASTE_YOUR_KEY_HERE
